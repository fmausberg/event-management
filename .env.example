# PostgreSQL (Prisma 7 / @prisma/adapter-pg)
# Docker server setup: use .env.docker.example and docs/docker.md instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_management"

# Required: generate a unique secret, e.g. `npx auth secret`.
# Never commit a real secret. Use HTTPS in production.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional deployment label: production keeps teal icons; test/staging/development use orange.
# Empty falls back to NODE_ENV. Set APP_ENV=test for test deployments using a production build.
APP_ENV=""

# Cloudinary: server-side credentials for event cover images (events_pictures).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Set only behind a trusted reverse proxy that validates/overwrites Host headers.
# AUTH_TRUST_HOST=true

# Optional OAuth: a provider appears only when BOTH values are configured.
# Google callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# SMTP (STRATO mailbox password; never use NEXT_PUBLIC_ for secrets)
SMTP_HOST="smtp.strato.de"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="ticket@mausberg.net"
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="ticket@mausberg.net"
MAIL_FROM_NAME="Event-Management"
# Optional: redirects every email to this address. Empty = real recipients.
MAIL_TEST_RECIPIENT=""

# Archive successfully sent mail in this STRATO mailbox via IMAP/TLS.
IMAP_ARCHIVE_ENABLED=true
IMAP_HOST="imap.strato.de"
IMAP_PORT=993
# Leave BOTH empty to reuse SMTP_USER/SMTP_PASSWORD, only for the STRATO host pair.
# Otherwise set both to credentials for the same mailbox used by SMTP.
IMAP_USER=""
IMAP_PASSWORD=""
# Normally empty: discover Sent via LIST/SPECIAL-USE (including XLIST).
# Optional exact EXISTING server mailbox path if discovery is ambiguous. Never creates folders.
IMAP_SENT_FOLDER=""

# Stripe Connect Direct Charges (start with test/sandbox credentials)
STRIPE_SECRET_KEY=""
# Snapshot webhook for events on Connected accounts, not the platform account
STRIPE_WEBHOOK_SECRET=""
# Random secret for POST /api/payments/reconcile (run every minute)
PAYMENTS_CRON_SECRET=""

# Dedicated AES-256-GCM ticket keyring; see docs/ticket-codes.md. No AUTH_SECRET reuse.
# JSON: {"active":"k1","keys":{"k1":"<32 random bytes as standard base64>"}}
TICKET_CODE_ENCRYPTION_KEYS=""

# Server-only voucher HMAC keyring; replace the placeholder before using vouchers.
# Generate 32 random bytes as standard Base64: see docs/vouchers.md (local setup).
# active is a number; key IDs are positive integers as JSON property names.
# Retain old versions during rotation; never reuse AUTH_SECRET or ticket keys.
VOUCHER_CODE_DIGEST_KEYS='{"active":1,"keys":{"1":"<BASE64_32_RANDOM_BYTES>"}}'
