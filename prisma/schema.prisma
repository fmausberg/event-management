generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  EVENTBRITE
  RAUSGEGANGEN
  EVERSPORTS
  URBAN_SPORTS_CLUB
  WELLPASS
  MYCLUBS
  EVENTIM
}

enum BookingStatus {
  PENDING_PAYMENT
  EXPIRED
  CONFIRMED
  CANCELLED
}

enum SyncStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum UserRole {
  ADMIN
  USER
}

enum CompanyRole {
  COMPANY_ADMIN
  COMPANY_USER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model User {
  cancellationDecisions CancellationRequest[] @relation("CancellationDecider")
  checkedInTickets Ticket[] @relation("TicketCheckedInBy")
  // ID & number
  id               String   @id @default(cuid())
  number           Int      @unique @default(autoincrement())

  // Attribute
  email String   @unique
  name  String?
  role  UserRole @default(USER)

  // Auth: null passwordHash supports existing users and OAuth-only accounts.
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // 1:n Relationen
  memberships             CompanyMembership[]
  createdEvents           Event[]             @relation("EventCreator")
  createdSeries           EventSeries[]       @relation("EventSeriesCreator")
  bookings                Booking[]           @relation("UserBookings")
  venueAssignments        VenueStaff[]
  eventAssignments        EventStaff[]
  accounts                Account[]
  sessions                Session[]
  createdVenueAssignments VenueStaff[]        @relation("VenueStaffAssignedBy")
  createdEventAssignments EventStaff[]        @relation("EventStaffAssignedBy")
  trainerProfiles         Trainer[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Shared across instances; keys contain a digest, never a plain email address.
model AuthRateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Company {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  name                 String
  slug                 String  @unique
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // 1:n Relationen
  venues      Venue[]
  memberships CompanyMembership[]
  eventSeries EventSeries[]
  events      Event[]
  trainers    Trainer[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyMembership {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  role   CompanyRole      @default(COMPANY_USER)
  status MembershipStatus @default(ACTIVE)
  // Normalized address for members added before an account exists.
  email  String?

  // n:1 Relationen
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@unique([companyId, userId])
  @@unique([companyId, email])
  @@index([userId, status])
}

model Venue {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  name         String
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  countryCode  String? @db.Char(2)

  // n:1 Relation
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // 1:n Relationen
  events             Event[]
  suggestedForSeries EventSeries[] @relation("SeriesSuggestedVenue")
  staff              VenueStaff[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@index([companyId, name])
}

model EventSeries {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  name                 String
  shortdescription     String?
  description          String?
  imageUrl             String?
  suggestedFreeCancellationUntilMinutesBeforeStart Int?
  suggestedDuration    Int?
  suggestedMaxSeats    Int?
  suggestedTicketPrice Decimal? @db.Decimal(10, 2)
  suggestedCurrency    String   @default("EUR") @db.Char(3)
  suggestedTrainerName String? //deprecated

  // n:1 Relationen
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User     @relation("EventSeriesCreator", fields: [createdById], references: [id], onDelete: Restrict)
  suggestedVenueId   String?
  suggestedVenue     Venue?   @relation("SeriesSuggestedVenue", fields: [suggestedVenueId], references: [id], onDelete: Restrict)
  suggestedTrainerId String?
  suggestedTrainer   Trainer? @relation("SeriesSuggestedTrainer", fields: [suggestedTrainerId], references: [id], onDelete: SetNull)

  // 1:n Relationen
  events Event[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@index([companyId, name])
}

model Event {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  name             String
  shortdescription String?
  description      String?
  beginsAt         DateTime?    @map("Begin")
  endsAt           DateTime?    @map("End")
  freeCancellationUntilMinutesBeforeStart Int?
  maxSeats         Int?
  status           EventStatus @default(DRAFT)
  ticketPrice      Decimal?     @db.Decimal(10, 2)
  currency         String      @default("EUR") @db.Char(3)
  trainerName      String?
  imageUrl         String?
  imagePublicId    String?

  // n:1 Relationen
  eventSeriesId String?
  eventSeries   EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Restrict)
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById   String?
  createdBy     User?        @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  venueId       String?
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // 1:n Relationen
  platformEvents PlatformEvent[]
  bookings       Booking[]
  staff          EventStaff[]
  trainers       EventTrainer[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@index([eventSeriesId, beginsAt])
  @@index([companyId, beginsAt])
  @@index([status, beginsAt])
}

model Booking {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  // null bedeutet interne Buchung; gesetzt bedeutet Buchung über eine Plattform.
  platform          Platform?
  externalBookingId String?
  quantity          Int
  status            BookingStatus @default(CONFIRMED)
  bookedAt          DateTime      @default(now())
  customerName      String?
  customerEmail     String?
  reservedUntil     DateTime?
  payment           Payment?

  // n:1 Relationen
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId  String?
  user    User?   @relation("UserBookings", fields: [userId], references: [id], onDelete: Restrict)

  // 1:n Relation
  cancellationRequests CancellationRequest[]
  tickets Ticket[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@unique([platform, externalBookingId])
  @@index([eventId, status])
  @@index([userId, bookedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  stripeAccountId   String
  checkoutSessionId String?       @unique
  paymentIntentId   String?       @unique
  publicToken       String        @unique
  amount            Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  checkoutRequest   Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  mail              PaymentMail?

  @@index([status, createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

// Ticket bearer links are encrypted while awaiting SMTP delivery, then erased.
model PaymentMail {
  paymentId        String    @id
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  encryptedMessage String?
  sentAt           DateTime?
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
}

model PlatformEvent {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  platform        Platform
  externalEventId String
  syncStatus      SyncStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  lastError       String?

  // n:1 Relation
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@unique([platform, externalEventId])
  @@index([eventId, syncStatus])
}

enum TicketStatus {
  VALID
  CANCELLED
}

model Ticket {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Attribute
  publicTokenHash String       @unique
  encryptedPublicToken String
  status          TicketStatus @default(VALID)
  checkedInAt     DateTime?
  checkedInById   String?
  checkedInBy     User?        @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  // n:1 Relation
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indizes
  @@index([bookingId, status])
}

model VenueStaff {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  //attribute
  email String?

  // n:1 Relation
  venueId      String
  venue        Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User    @relation("VenueStaffAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, userId])
  @@unique([venueId, email])
  @@index([userId])
}

model EventStaff {
  // ID & number
  id     String  @id @default(cuid())
  number Int     @unique @default(autoincrement())
  email  String?

  // n:1 Relation
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User    @relation("EventStaffAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([userId])
}

model Trainer {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  //attribute
  firstName String
  lastName  String
  email     String

  // n:1 Relation
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 1:n Relation
  events             EventTrainer[]
  suggestedForSeries EventSeries[]  @relation("SeriesSuggestedTrainer")

  // Timestamps

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Indizes
  @@unique([companyId, email])
  @@index([userId])
}

model EventTrainer {
  // ID & number
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // n:1 Relation
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())

  // Indizes
  @@unique([eventId, trainerId])
  @@index([trainerId])
}


enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CancellationRefundStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
  REVIEW
}

model CancellationRequest {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status CancellationRequestStatus @default(PENDING)
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  decidedById String?
  decidedBy User? @relation("CancellationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  customerReason String?
  internalNote String?
  automatic Boolean @default(false)
  refundStatus CancellationRefundStatus @default(NONE)
  stripeRefundId String? @unique
  refundAttempt Int @default(0)
  refundStartedAt DateTime?
  refundCheckedAt DateTime?
  refundLockedUntil DateTime?
  refundError String?
  mails CancellationMail[]
  @@index([bookingId, requestedAt])
  @@index([status, requestedAt])
  @@index([refundStatus, refundCheckedAt])
}

model CancellationMail {
  id String @id
  requestId String
  request CancellationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  encryptedMessage String?
  sentAt DateTime?
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  @@index([sentAt, createdAt])
}
