# Copy to .env.docker. Use: docker compose --env-file .env.docker ...
# Generate TWO DIFFERENT secrets: openssl rand -hex 32
# Password must be URL-safe (hex recommended), as it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
AUTH_SECRET=
AUTH_URL=https://events.example.com
APP_PORT=3000
# Use test or staging for orange environment icons.
APP_ENV=production
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# SMTP: single-quote passwords to prevent Compose variable interpolation.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tickets@mausberg.net
SMTP_PASSWORD=''
MAIL_FROM_ADDRESS=tickets@mausberg.net
MAIL_FROM_NAME=Event-Management
# Optional: redirects every email to this address. Empty = real recipients.
MAIL_TEST_RECIPIENT=

# Stripe Connect Direct Charges (start with test/sandbox credentials)
STRIPE_SECRET_KEY=""
# Snapshot webhook for events on Connected accounts, not the platform account
STRIPE_WEBHOOK_SECRET=""
# Random secret for POST /api/payments/reconcile (run every minute)
PAYMENTS_CRON_SECRET=""
